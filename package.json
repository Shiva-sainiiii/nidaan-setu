{
  "name": "nidaan-setu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "check:demo": "node scripts/demo-check.mjs",
    "start:lan": "next build && next start -H 0.0.0.0 -p 3000",
    "db:reset": "node scripts/db-setup.mjs",
    "db:docker": "docker start nidaan-setu-db || docker run -d --name nidaan-setu-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=nidaansetu -p 54329:5432 postgres:16-alpine",
    "check:bundle": "node scripts/bundle-check.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:db": "node --test \"tests/db/*.test.ts\"",
    "check:sql": "npm run test:db",
    "test:e2e": "npm run check:demo && npm run check:bundle",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.49.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
