# Required. Local Docker Postgres, or Supabase: Project Settings > Database > Connection string
# (use the "Transaction pooler" URI, port 6543, when deploying to Vercel).
DATABASE_URL=postgres://postgres:postgres@localhost:54329/testbridge

# Optional. If set, screens refresh instantly via Supabase Realtime (otherwise every 2s).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
